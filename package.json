{
  "name": "@stoplight/json-schema-viewer",
  "version": "0.0.0",
  "description": "A beautiful React component for viewing JSON Schema",
  "keywords": [],
  "homepage": "https://github.com/stoplightio/json-schema-viewer",
  "bugs": "https://github.com/stoplightio/json-schema-viewer/issues",
  "license": "Apache-2.0",
  "author": "Stoplight <support@stoplight.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/stoplightio/json-schema-viewer"
  },
  "files": [
    "**/*"
  ],
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "rslib build",
    "storybook:build": "storybook build -c .storybook -o docs-auto",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stoplight/json": "^3.21.7",
    "@stoplight/json-schema-tree": "^4.0.0",
    "@stoplight/react-error-boundary": "^3.0.0",
    "@types/json-schema": "^7.0.15",
    "classnames": "^2.5.1",
    "fnv-plus": "^1.3.1",
    "jotai": "^2.16.2",
    "jotai-family": "^1.0.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@rsbuild/plugin-react": "^1.4.3",
    "@rslib/core": "^0.19.3",
    "@stoplight/types": "^14.1.1",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/react-vite": "^10.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "happy-dom": "^20.3.4",
    "json-schema": "^0.4.0",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "storybook": "^10.2.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0"
}
